# =====================================================================
# VendorFlow — Environment Configuration
# =====================================================================

# Environment mode: 'development', 'production', 'test'
ENVIRONMENT=development
APP_NAME="VendorFlow"
DEBUG=true

# Database Connection (PostgreSQL or SQLite for zero-setup local dev)
# For Supabase / PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For local SQLite dev:
DATABASE_URL=sqlite:///./vendorflow.db

# JWT & Authentication
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Google Gemini API (Recommended: fast, structured output compliant)
GEMINI_API_KEY=AQ.Ab8RN6KKbm_ZMIsfVTInueuG5AulIjW6Et-tfL5tKVLjwx2-XQ
GEMINI_MODEL=gemini-3.5-flash

# OpenAI API (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transactional Email (Resend)
# If left empty, VendorFlow runs in dev-logger mode (prints emails to logs & DB audit table)
RESEND_API_KEY=
SENDER_EMAIL=onboarding@vendorflow.io

# Supabase (Optional: if using Supabase Storage or Supabase Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vendor-documents

# Document Upload & Storage Constraints
LOCAL_STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=10485760 # 10 MB
ALLOWED_FILE_TYPES=["application/pdf","image/png","image/jpeg"]

# Expiry Tracking & Reminder Scheduler
EXPIRY_SCHEDULER_INTERVAL_SECONDS=3600 # Run hourly in background
REMINDER_INTERVAL_DAYS=[30, 7, 1]
