# =====================================================================
# FormGate / VendorFlow — Environment Configuration
# =====================================================================

# Environment mode: 'development', 'production', 'test'
ENVIRONMENT=development
APP_NAME="FormGate"
DEBUG=true

# Server Port (Hugging Face Spaces automatically forwards port 7860)
PORT=7860
HOST=0.0.0.0

# =====================================================================
# Database Connection (Supabase PostgreSQL / SQLite)
# =====================================================================
# In Production (Supabase):
# Direct connection (Session mode):
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Connection Pooler (Transaction mode / Port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# For zero-setup local dev:
DATABASE_URL=sqlite:///./vendorflow.db

# =====================================================================
# Security & Auth
# =====================================================================
# In production, generate a secure random 32+ character hex string:
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INVITATION_TOKEN_EXPIRE_DAYS=14

# =====================================================================
# Application URLs & CORS (Vercel Frontend & HF Spaces Backend)
# =====================================================================
# Comma-separated list of allowed frontend origins (e.g. your Vercel URL and localhost):
BACKEND_CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000","http://127.0.0.1:3000"]
ALLOW_VERCEL_PREVIEWS=true

# Base URL where frontend is hosted (used for generating vendor invitation links):
APP_BASE_URL=http://localhost:3000

# Base URL where backend API is hosted:
API_BASE_URL=http://localhost:8000

# =====================================================================
# Document Storage Configuration
# =====================================================================
# Active Provider: 'auto', 'cloudflare_r2', 'supabase', 'local'
# ('auto' uses Cloudflare R2 if R2 keys provided, else Supabase if Supabase keys provided, else Local)
STORAGE_PROVIDER=auto

# --- Cloudflare R2 (Recommended for Document Storage, Zero Egress Fees) ---
# Found in Cloudflare Dashboard -> R2 -> Manage R2 API Tokens:
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=vendor-documents
CLOUDFLARE_R2_PUBLIC_URL=

# --- Supabase Storage (Alternative/Secondary Storage) ---
# Found in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=vendor-documents

# Document Upload Constraints
LOCAL_STORAGE_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=10485760 # 10 MB
ALLOWED_FILE_TYPES=["application/pdf","image/png","image/jpeg"]

# =====================================================================
# AI / LLM Workflow Generation
# =====================================================================
# 1. OpenAI API (Production AI Workflow Generator)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 2. Local Ollama AI Model (Optional for local development only)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_SECONDS=120.0

# =====================================================================
# Transactional Email (Resend or SMTP)
# =====================================================================
# If left empty, FormGate runs in dev-logger mode (prints emails to logs & DB audit table)
RESEND_API_KEY=
SENDER_EMAIL=portal@formgate.in

# Expiry Tracking & Reminder Scheduler
EXPIRY_SCHEDULER_INTERVAL_SECONDS=3600 # Run hourly in background
REMINDER_INTERVAL_DAYS=[30, 7, 1]
